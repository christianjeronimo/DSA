 * @file solitaire.cpp-c++ version of solitaire encryption
 * @author Christian Jeronimo
 */

#include <iostream>
#include <string>
#include <vector>
#include <fstream>
#include <algorithm>
#include <iterator>

std::string clean(std::string& message) {
  std::string clean_message = "";
  for (char c : message) {
    if (std::isalpha(c)) {
      clean_message += std::toupper(c);
    }
  }
  int padding = (5 - clean_message.length() % 5) % 5;
  clean_message += std::string(padding, 'X');

  return clean_message;
}

std::vector<int> read_deck(const std::string& file_name) {
  std::vector<int> deck;
  std::ifstream file(file_name);

  if (file.is_open()) {
    int card;

    while (file >> card) {
      deck.push_back(card);
    }
  }

  return deck;
}

void move_card(std::vector<int>& deck, int card, int steps) {
  for (int i = 0; i < steps; ++i) {
    auto it = std::find(deck.begin(), deck.end(), card);
    int index = std::distance(deck.begin(), it);
    
    if (index == deck.size() - 1) {
      std::swap(deck[index], deck[0]);
    } else {
      std::swap(deck[index], deck[index + 1]);
    }
  }
}

void triple_cut(std::vector<int>& deck) {
  auto first_j = std::find_if(deck.begin(), deck.end(), [](int card) {
    return card == 27 || card == 28;
  });

  auto second_j = std::find_if(first_j + 1, deck.end(), [](int card) {
    return card == 27 || card == 28;
  });

  int top_idx = std::distance(deck.begin(), first_j);
  int bottom_idx = std::distance(deck.begin(), second_j);
  std::vector<int> temp_deck;
  temp_deck.reserve(deck.size());
  temp_deck.insert(temp_deck.end(), deck.begin() + bottom_idx + 1, deck.end());
  temp_deck.insert(temp_deck.end(), deck.begin() + top_idx, deck.begin() + bottom_idx + 1);
  temp_deck.insert(temp_deck.end(), deck.begin(), deck.begin() + top_idx);
  deck = std::move(temp_deck);
}

void bottom_cut(std::vector<int>& deck) {
  int bottom_value = deck.back();

  if (bottom_value > 27) {
    bottom_value = 27;
  }

  std::vector<int> cut_cards(deck.begin(), deck.begin() + bottom_value);
  deck.erase(deck.begin(), deck.begin() + bottom_value);
  deck.insert(deck.end() - 1, cut_cards.begin(), cut_cards.end());
}

int keystream_value(std::vector<int>& deck) {
  while (true) {
    move_card(deck, 27, 1);
    move_card(deck, 28, 2);
    triple_cut(deck);
    bottom_cut(deck);
    int top_value = (deck[0] < 27) ? deck[0] : 27;
    int keystream_card = deck[top_value];

    if (keystream_card < 27) {
      return keystream_card;
    }
  }
}

std::vector<int> text_to_num(const std::string& prep) {
  std::vector<int> numbers(prep.size());
  std::transform(prep.begin(), prep.end(), numbers.begin(), [](char c) {
    return c - 'A' + 1;
  });

  return numbers;
}

std::string num_to_text(const std::vector<int>& numbers) {
  std::string result = "";

  for (int num : numbers) {
    result += static_cast<char>(num + 'A' - 1);
  }

  return result;
}

std::string encrypt(std::vector<int>& deck, std::string& prep) {
  std::vector<int> message_numbers = text_to_num(prep);
  std::vector<int> keystream;
  std::vector<int> encrypted_numbers;

  for (size_t i = 0; i < message_numbers.size(); ++i) {
    keystream.push_back(keystream_value(deck));
  }

  for (size_t i = 0; i < message_numbers.size(); ++i) {
    int m = message_numbers[i];
    int k = keystream[i];
    int math_result = (m + k - 1) % 26 + 1;
    encrypted_numbers.push_back(math_result);
  }

  return num_to_text(encrypted_numbers);
}

std::string decrypt(std::vector<int>& deck, std::string& prep) {
  std::vector<int> message_numbers = text_to_num(prep);
  std::vector<int> keystream;
  std::vector<int> decrypted_numbers;

  for (size_t i = 0; i < message_numbers.size(); ++i) {
    keystream.push_back(keystream_value(deck));
  }

  for (size_t i = 0; i < message_numbers.size(); ++i) {
    int m = message_numbers[i];
    int k = keystream[i];
    int math_result = (m - k - 1) % 26 + 1;
    decrypted_numbers.push_back(math_result);
  }

  return num_to_text(decrypted_numbers);
}

int main(int argc, char *argv[]) {
  if (argc != 3) {
    std::cout << "Usage: ./a.out e/d deck-.txt" << std::endl;
    return 0;
  }

  char mode = argv[1][0];
  std::string deck_file = argv[2];
  std::vector<int> deck = read_deck(deck_file);

  if (deck.empty()) {
    std::cerr << "Error: File " << deck_file <<  " not found." << "\n";
    return 1;
  }

  if (mode == 'e') {
    std::string message;
    std::cout << "Enter message to be encrypted(non-letters ignored): " << std::endl;
    std::getline(std::cin >> std::ws, message);
    std::string prep = clean(message);
    std::cout << "Plaintext message is: " << prep << "\n";
    std::string encrypted_message = encrypt(deck, prep);
    std::cout << "The encrypted message is: " << encrypted_message << "\n";
  } else if (mode == 'd') {
    std::string message;
    std::cout << "Enter message to be decrypted: " << std::endl;
    std::cin >> message;
    std::string decrypted_message = decrypt(deck, message);
    std::cout << "The decrypted message is: " << decrypted_message << "\n";
  } else {
    std::cout << "Invalid mode. Use 'e' for encryption or 'd' for decryption." << std::endl;
  }

  return 0;
}
